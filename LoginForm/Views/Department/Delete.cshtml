@model LoginForm.Models.Department

<div class="container mt-5 card">
    <h2 class="mb-3">Delete Department</h2>

    <div class="mb-4">
        <div>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Department Code:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.code</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Name:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.Name</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Created By:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.Createdby</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Created Date:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.CreatedDate</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Edited By:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.Editedby</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Edited Date:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.EditedDate</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label"><strong>Is Active:</strong></label>
                </div>
                <div class="col-md-8">
                    <p>@Model.isActive</p>
                </div>
            </div>

        </div>
    </div>

    <form method="post" asp-action="Delete" asp-controller="Department">

        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row">
            <div class="col-md-4"></div>
            <div class="col-md-8">
                <button type="submit" class="btn btn-danger" id="deleteBtn">Delete</button>
                <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </form>