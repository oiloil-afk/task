@model IEnumerable<LoginForm.Models.Department>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">




<div>
    <div class="justify-content-between align-content-center d-flex">
        <h3>
            Department Record
        </h3>
        <a asp-controller="Department" asp-action="Add" class="btn btn-light">Add</a>
    </div>

    <table id="tabledata" >
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.code)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Createdby)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CreatedDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Editedby)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EditedDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.isActive)
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.code</td>
                    <td>@item.Name</td>
                    <td>@item.Createdby</td>
                    <td>@item.CreatedDate</td>
                    <td>@item.Editedby</td>
                    <td>@item.EditedDate</td>
                    <td>@item.isActive</td>
                    <td>
                        <div>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="text-primary me-2">
                                <i class="bi bi-pencil-square"></i>

                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-success me-2">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="text-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }

        </tbody>

    </table>
</div>
@section Scripts
{
    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.js"> </script>
    <link href="https://cdn.datatables.net/2.3.8/css/dataTables.dataTables.css" rel="stylesheet" />

    <script>
        $(document).ready(function()
        {
        $("#tabledata").DataTable();
        });
    </script>
}