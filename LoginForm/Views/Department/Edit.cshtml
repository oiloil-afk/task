@model LoginForm.Models.Department

@{
    ViewData["Title"] = "Edit Department";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8">
            <h2>@ViewData["Title"]</h2>
            <hr />

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row mb-3">
                    <label class="col-md-4 col-form-label">Department ID</label>
                    <div class="col-md-8">
                        <input class="form-control" asp-for="Dep_id" />
                        <span asp-validation-for="Dep_id" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-4 col-form-label">Code</label>
                    <div class="col-md-8">
                        <input class="form-control" asp-for="code" />
                        <span asp-validation-for="code" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-md-4 col-form-label">Name</label>
                    <div class="col-md-8">
                        <input class="form-control" asp-for="Name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

               

                <div class="row mb-3">
                    <label class="col-md-4 col-form-label">Is Active</label>
                    <div class="col-md-8">
                        <input class="form-check-input" asp-for="isActive" type="checkbox" />
                        <span asp-validation-for="isActive" class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-8 offset-md-4">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

