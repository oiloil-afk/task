@{

}

@model LoginForm.Models.Employee

<div>
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Employee Code:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.EmployeeCode</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Name:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.Name</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Email:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.Email</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Phone:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.Phone</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Age:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.Age</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Date of Birth:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.DateOfBirth</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Date of Joining:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.DateOfJoining</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Office Time:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.OfficeTime</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label"><strong>Gender:</strong></label>
        </div>
        <div class="col-md-8">
            <p>@Model.Gender</p>
        </div>
    </div>
</div>

