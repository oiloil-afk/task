@model Task2.ViewModel.CreateEmployeeViewModel

<table class="table table-bordered" id="educationTable">
    <thead class="table-dark">
        <tr>
            <th>Institution</th>
            <th>Degree</th>
            <th>Percentage</th>
            <th>Year</th>
            <th>From</th>
            <th>To</th>
            <th>Delete</th>
        </tr>
    </thead>

    <tbody id="educationTableBody">

        @for (int i = 0; i < Model.EducationDetails.Count; i++)
        {
            <tr>

                <td>
                    <input asp-for="EducationDetails[@i].Id" type="hidden" />
                    <input asp-for="EducationDetails[@i].Institution" class="form-control" />
                </td>

                <td>
                    <input asp-for="EducationDetails[@i].Degree" class="form-control" />
                </td>

                <td>
                    <input asp-for="EducationDetails[@i].Percentage" class="form-control" />
                </td>

                <td>
                    <input asp-for="EducationDetails[@i].YearOfPassing" class="form-control" />
                </td>

                <td>
                    <input asp-for="EducationDetails[@i].From"
                           type="date"
                           class="form-control" />
                </td>

                <td>
                    <input asp-for="EducationDetails[@i].To"
                           type="date"
                           class="form-control" />
                </td>

                <td>
                    <button type="button"
                            class="btn btn-danger btn-delete">
                        Delete
                    </button>
                </td>

            </tr>
        }

    </tbody>
</table>

<button type="button"
        class="btn btn-success"
        id="addEducation">
    Add Education
</button>

<script>

    $(document).ready(function () {

        $("#educationTable").on("click", ".btn-delete", function () {

            $(this).closest("tr").remove();

            reIndex();

        });

        $("#addEducation").click(function () {

            var index = $("#educationTableBody tr").length;

            var row = `
            <tr>

                <td>
                    <input type="hidden"
                           name="EducationDetails[${index}].Id"
                           value="00000000-0000-0000-0000-000000000000"/>

                    <input class="form-control"
                           name="EducationDetails[${index}].Institution"/>
                </td>

                <td>
                    <input class="form-control"
                           name="EducationDetails[${index}].Degree"/>
                </td>

                <td>
                    <input class="form-control"
                           name="EducationDetails[${index}].Percentage"/>
                </td>

                <td>
                    <input class="form-control"
                           name="EducationDetails[${index}].YearOfPassing"/>
                </td>

                <td>
                    <input type="date"
                           class="form-control"
                           name="EducationDetails[${index}].From"/>
                </td>

                <td>
                    <input type="date"
                           class="form-control"
                           name="EducationDetails[${index}].To"/>
                </td>

                <td>
                    <button type="button"
                            class="btn btn-danger btn-delete">
                        Delete
                    </button>
                </td>

            </tr>`;

            $("#educationTableBody").append(row);

        });

        function reIndex() {

            $("#educationTableBody tr").each(function (i) {

                $(this).find("input").each(function () {

                    var name = $(this).attr("name");

                    if (name) {

                        name = name.replace(/EducationDetails\[\d+\]/,
                                            "EducationDetails[" + i + "]");

                        $(this).attr("name", name);
                    }

                });

            });

        }

    });

</script>